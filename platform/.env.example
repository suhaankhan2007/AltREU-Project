SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional -- only needed to actually send (notify_volunteers.js --confirm).
# Not one of server.js's required vars; the live server never reads this,
# so leaving it unset can't break the deployed site.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional -- SciStarter Participation API (hashed-email affiliate
# reporting). Neither var is required at startup; a missing/misconfigured
# key just makes reportToSciStarter() a silent no-op, it can never crash
# or slow down the live server.
# SCISTARTER_API_KEY=your-key-from-scistarter.org/api/key
# SCISTARTER_PROJECT_SLUG=discord-hunt-for-gravitational-microlensing-events
